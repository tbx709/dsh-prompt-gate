{
  "name": "dsh-prompt-gate",
  "version": "0.1.0",
  "description": "Rewrites the first message of a new session into a prompt dsh can execute, and unlocks the tools only after you approve it.",
  "type": "module",
  "license": "MIT",
  "author": "lr_tbx (https://github.com/tbx709)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbx709/dsh-prompt-gate.git"
  },
  "homepage": "https://github.com/tbx709/dsh-prompt-gate#readme",
  "bugs": {
    "url": "https://github.com/tbx709/dsh-prompt-gate/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js",
    "test": "node test/plugin.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
